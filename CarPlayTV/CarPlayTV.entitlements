<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Navigation entitlement: gives the app a full CarPlay window to draw video into.
	     Works in the Simulator as-is; real devices need Apple to grant it to your team. -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
</dict>
</plist>
