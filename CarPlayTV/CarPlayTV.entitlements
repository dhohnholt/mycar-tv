<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay audio app, granted by Apple 2026-10-15. Covers "a mixture of audio and video": Car TV is
	     listed in every CarPlay car and presents video (CPPlaybackConfiguration) where the car supports it.
	     Video-only apps (carplay-video, also granted) are hidden in cars without CarPlay video, and Apple
	     doesn't allow both in one app, so don't add carplay-video back. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- Experiment (2026-10-15): CarTV has audio + video, and CarPlay hosts its car scene directly
	     (its own window) even in the Highlander, which lacks CarPlay video. Testing whether the video
	     entitlement is what gives an app that window. Apple says combining both is "not supported". -->
	<key>com.apple.developer.carplay-video</key>
	<true/>
</dict>
</plist>
