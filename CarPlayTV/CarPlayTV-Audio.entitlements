<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay audio app: shown in every CarPlay car, and (iOS 26.4+) may present video where the car
	     supports it. Requested from Apple 2026-10-14. Used by Simulator builds now; once Apple grants it,
	     point device builds here too and drop carplay-video (Apple doesn't allow both in one app). -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
